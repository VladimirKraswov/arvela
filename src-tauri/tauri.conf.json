{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentMesh Desktop",
  "version": "0.2.19",
  "identifier": "dev.local.opencodedesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentMesh Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* http://localhost:* http://[::1]:* ws://127.0.0.1:* ws://localhost:* ws://[::1]:*",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop workspace for OpenCode and Pi",
    "longDescription": "Native desktop workspace for independently installed OpenCode and Pi agents: projects, sessions, streaming tool output, permissions, PTY and model selection. The engine is installed and updated independently of this application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
