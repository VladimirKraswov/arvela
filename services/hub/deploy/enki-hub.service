[Unit]
Description=Enki private catalog and session observability
After=network-online.target
Wants=network-online.target
[Service]
User=enki-hub
Group=enki-hub
ExecStart=/usr/bin/python3 /opt/enki-hub/server.py --data /var/lib/enki-hub --cert /etc/enki-hub/server.crt --key /etc/enki-hub/server.key
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/enki-hub
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=512M
TasksMax=40
[Install]
WantedBy=multi-user.target
