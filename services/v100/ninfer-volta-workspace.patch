diff --git a/tests/ops/softmax_attention/test_volta_workspace.cpp b/tests/ops/softmax_attention/test_volta_workspace.cpp
new file mode 100644
index 0000000..41cbc0a
--- /dev/null
+++ b/tests/ops/softmax_attention/test_volta_workspace.cpp
@@ -0,0 +1,46 @@
+#include "ninfer/ops/softmax_attention.h"
+#include <algorithm>
+#include <cstdlib>
+#include <iostream>
+
+int main() {
+#if defined(NINFER_SM70)
+#ifdef _WIN32
+    _putenv_s("NINFER_ATTN_VOLTA_FLASH", "1");
+    _putenv_s("NINFER_ATTN_VOLTA_FLASH_INT8", "1");
+#else
+    setenv("NINFER_ATTN_VOLTA_FLASH", "1", 1);
+    setenv("NINFER_ATTN_VOLTA_FLASH_INT8", "1", 1);
+#endif
+    int failures = 0;
+    using namespace ninfer;
+    for (const auto storage : {KvCacheStorage::BFloat16, KvCacheStorage::Int8Group64}) {
+        for (const auto heads : {ops::AttentionHeadGeometry{256,24,4},
+                                ops::AttentionHeadGeometry{256,16,2}}) {
+            for (const int width : {512,1920,2048}) {
+                for (const unsigned capacity : {32769U,65536U,262144U}) {
+                    const ops::CausalAttentionExecutionEnvelope whole{1,capacity,false,false,true};
+                    const auto budget = ops::causal_softmax_attention_workspace_capacity_bytes(
+                        heads,storage,whole,1,1,width);
+                    for (const unsigned visible : {16384U,24576U,32768U}) {
+                        const ops::CausalAttentionExecutionEnvelope point{visible,visible,false,false,true};
+                        const auto needed = ops::causal_softmax_attention_workspace_capacity_bytes(
+                            heads,storage,point,1,width,width);
+                        if (budget < needed) {
+                            std::cerr << "Workspace envelope misses prefix: width=" << width
+                                      << " capacity=" << capacity << " visible=" << visible
+                                      << " reserved=" << budget << " needed=" << needed << '\n';
+                            ++failures;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    std::cout << "Volta workspace interval failures=" << failures << '\n';
+    return failures ? 1 : 0;
+#else
+    std::cout << "SKIP: Volta-specific route contract\n";
+    return 77;
+#endif
+}
