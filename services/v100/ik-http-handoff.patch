--- /dev/null
+++ b/examples/server/server-socket.h
@@ -0,0 +1,14 @@
+#pragma once
+#include "vendor/cpp-httplib/httplib.h"
+#if defined(__linux__)
+#include <sys/socket.h>
+#endif
+
+inline void configure_server_socket(socket_t sock) {
+    httplib::default_socket_options(sock);
+#if defined(__linux__)
+    // Match SO_REUSEADDR peers when a previous HTTP connection is in TIME_WAIT.
+    const int enabled = 1;
+    (void)::setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, &enabled, sizeof(enabled));
+#endif
+}
--- /dev/null
+++ b/examples/server/socket-handoff-test.cpp
@@ -0,0 +1,45 @@
+#include <iostream>
+#if defined(__linux__)
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <unistd.h>
+#include "server-socket.h"
+struct Socket {
+    int fd;
+    explicit Socket(int value) : fd(value) {}
+    ~Socket() { if (fd >= 0) ::close(fd); }
+    Socket(const Socket&) = delete;
+};
+void native_options(int fd) { configure_server_socket(fd); }
+bool configure(int fd, bool native) {
+    if (fd < 0) return false;
+    if (native) native_options(fd);
+    else { const int enabled=1; if (::setsockopt(fd,SOL_SOCKET,SO_REUSEADDR,&enabled,sizeof(enabled))) return false; }
+    const timeval wait{2,0};
+    return ::setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&wait,sizeof(wait))==0;
+}
+bool handoff(bool native_first) {
+    sockaddr_in a{};a.sin_family=AF_INET;a.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+    {
+        Socket listener(::socket(AF_INET,SOCK_STREAM,0));
+        if (!configure(listener.fd,native_first) || ::bind(listener.fd,reinterpret_cast<sockaddr*>(&a),sizeof(a)) || ::listen(listener.fd,1)) return false;
+        socklen_t size=sizeof(a);if (::getsockname(listener.fd,reinterpret_cast<sockaddr*>(&a),&size)) return false;
+        Socket client(::socket(AF_INET,SOCK_STREAM,0));
+        if (!configure(client.fd,false) || ::connect(client.fd,reinterpret_cast<sockaddr*>(&a),sizeof(a))) return false;
+        Socket accepted(::accept(listener.fd,nullptr,nullptr));if (!configure(accepted.fd,native_first)) return false;
+        char byte;
+        if (::shutdown(accepted.fd,SHUT_WR) || ::recv(client.fd,&byte,1,0)!=0) return false;
+        if (::shutdown(client.fd,SHUT_WR) || ::recv(accepted.fd,&byte,1,0)!=0) return false;
+    }
+    Socket next(::socket(AF_INET,SOCK_STREAM,0));
+    return configure(next.fd,!native_first) && ::bind(next.fd,reinterpret_cast<sockaddr*>(&a),sizeof(a))==0;
+}
+int main() {
+    bool forward=handoff(true),reverse=handoff(false);
+    std::cout << "IK->SO_REUSEADDR=" << forward << " SO_REUSEADDR->IK=" << reverse << '\n';
+    return forward && reverse ? 0 : 1;
+}
+
