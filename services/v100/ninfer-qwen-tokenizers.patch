+int test_implicit_qwen_bos() {
+    auto source = resources();
+    auto config = nlohmann::json::parse(source.tokenizer_config_json);
+    const Frontend baseline = make_frontend(source, false);
+    ninfer::ChatMessage message;
+    message.role = ninfer::ChatRole::User;
+    message.parts.push_back(ninfer::MessagePart{
+        .kind = ninfer::MessagePartKind::Text, .text = "Привет a\xcd\x98", .media = {}});
+    ninfer::PromptInput input;
+    input.messages.push_back(std::move(message));
+    config.erase("add_bos_token");
+    config["bos_token"] = nullptr;
+    source.tokenizer_config_json = config.dump();
+    const Frontend modern = make_frontend(source, false);
+    const auto old_prompt = baseline.prepare(input);
+    const auto new_prompt = modern.prepare(input);
+    int failures = check(FrontendFactory::inspect(old_prompt).token_ids ==
+                         FrontendFactory::inspect(new_prompt).token_ids,
+                         "omitted disabled BOS changed rendered prompt token IDs");
+    for (auto [field, value] : std::vector<std::pair<const char*, nlohmann::json>>{
+             {"add_bos_token", true}, {"bos_token", "<|endoftext|>"},
+             {"add_prefix_space", true}}) {
+        auto invalid = config; invalid[field] = value;
+        source.tokenizer_config_json = invalid.dump();
+        failures += check(throws_invalid_argument([&] { (void)make_frontend(source, false); }),
+                          "unsupported or ambiguous implicit tokenizer prefix accepted");
+    }
+    return failures;
+}
