+int test_qwen_split_variants() {
+    auto source = resources();
+    auto root = nlohmann::json::parse(source.tokenizer_json);
+    const auto mark = byte_level_symbol(0xcd) + byte_level_symbol(0x98); // U+0358
+    root["model"]["vocab"][mark] = 3000;
+    root["model"]["vocab"]["a" + mark] = 3001;
+    root["model"]["vocab"]["!!"] = 3002;
+    root["model"]["vocab"]["!!" + mark] = 3003;
+    root["model"]["merges"] = nlohmann::json::array({
+        nlohmann::json::array({byte_level_symbol(0xcd), byte_level_symbol(0x98)}),
+        nlohmann::json::array({"a", mark}),
+        nlohmann::json::array({"!", "!"}),
+        nlohmann::json::array({"!!", mark})});
+    root["normalizer"] = {{"type", "NFC"}};
+    const std::string modern = R"qwen((?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+|\p{N}| ?[^\s\p{L}\p{M}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+)qwen";
+    const std::string legacy = R"qwen((?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}| ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+)qwen";
+    int failures = 0;
+    auto config = nlohmann::json::parse(source.tokenizer_config_json);
+    // An absent redundant map is valid, but a present malformed map is not.
+    for (const auto& invalid : {nlohmann::json(nullptr), nlohmann::json::array()}) {
+        auto malformed = config; malformed["added_tokens_decoder"] = invalid;
+        const auto raw = malformed.dump();
+        failures += check(throws_invalid_argument([&] {
+            (void)fi::Tokenizer({source.tokenizer_json, raw, source.generation_config_json});
+        }), "malformed explicit added_tokens_decoder was accepted");
+    }
+    config.erase("added_tokens_decoder");
+    source.tokenizer_config_json = config.dump();
+    for (bool include_marks : {true, false}) {
+        root["pre_tokenizer"] = {{"type", "Sequence"}, {"pretokenizers", {
+            {{"type", "Split"}, {"pattern", {{"Regex", include_marks ? modern : legacy}}},
+             {"behavior", "Isolated"}, {"invert", false}},
+            {{"type", "ByteLevel"}, {"add_prefix_space", false}, {"use_regex", false}}}}};
+        source.tokenizer_json = root.dump();
+        const fi::Tokenizer tokenizer({source.tokenizer_json, source.tokenizer_config_json,
+                                       source.generation_config_json});
+        failures += check(tokenizer.encode("a\xcd\x98") == (include_marks ? std::vector<int>{3001} : std::vector<int>{fixture_byte_token('a'), 3000}),
+                          "combining mark word merge disagrees with declared Split pattern");
+        failures += check(tokenizer.encode("!!\xcd\x98") == (include_marks ? std::vector<int>{3002, 3000} : std::vector<int>{3003}),
+                          "combining mark punctuation merge disagrees with declared Split pattern");
+        const std::array<std::size_t, 1> boundary{1};
+        const auto encoded = tokenizer.encode_with_boundaries("a\xcd\x98", boundary);
+        failures += check(encoded.input_ids == tokenizer.encode("a\xcd\x98"),
+                          "boundary-aware path changed token IDs");
+        failures += check(encoded.boundaries[0].exact_frontier == (include_marks ? std::optional<std::size_t>{} : std::optional<std::size_t>{1}),
+                          "byte boundary does not reflect declared word merge");
+        failures += check(tokenizer.encode("a\xcd\x98", {.max_tokens = 1}) == (include_marks ? std::vector<int>{3001} : std::vector<int>{fixture_byte_token('a')}),
+                          "bounded encoding ignored tokenizer variant");
+    }
+    return failures;
+}
